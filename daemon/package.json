{
  "name": "@shall/daemon",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "exports": {
    "./main": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./router": {
      "types": "./dist/http/router.d.ts",
      "default": "./dist/http/router.js"
    },
    "./home": {
      "types": "./dist/host/shall-home.d.ts",
      "default": "./dist/host/shall-home.js"
    }
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "NODE_ENV=production node dist/main.js"
  },
  "dependencies": {
    "@hono/node-server": "latest",
    "@hono/trpc-server": "latest",
    "@shall/core": "workspace:*",
    "@trpc/server": "latest",
    "hono": "latest",
    "http-proxy": "latest",
    "ulid": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/http-proxy": "latest",
    "tsx": "latest"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
