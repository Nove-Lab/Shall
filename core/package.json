{
  "name": "@shall/core",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    "./graph": {
      "types": "./dist/graph/index.d.ts",
      "default": "./dist/graph/index.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "default": "./dist/store/index.js"
    },
    "./arith": {
      "types": "./dist/arith/index.d.ts",
      "default": "./dist/arith/index.js"
    },
    "./serialize": {
      "types": "./dist/serialize/index.d.ts",
      "default": "./dist/serialize/index.js"
    },
    "./exchange": {
      "types": "./dist/exchange/index.d.ts",
      "default": "./dist/exchange/index.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "default": "./dist/version.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test arith/*.test.ts graph/*.test.ts serialize/*.test.ts store/*.test.ts"
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "tsx": "^4.23.12"
  }
}
